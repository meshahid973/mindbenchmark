{
  "name": "mindbenchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:bundle",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src scripts vite.config.ts",
    "format": "biome format --write src scripts vite.config.ts",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.23.0"
  }
}
